# Copy this file to `.env` and fill in your values. `.env` is git-ignored —
# never commit real keys. Load with: `set -a && source .env && set +a`
# (or export the variables yourself). See cmd/server/main.go.

# Which AI company to use for diagnosis. Empty = no AI (verbatim diagnosis).
# Currently supported: groq
SOTEACH_AI_PROVIDER=groq

# Your API key for the provider above.
SOTEACH_AI_API_KEY=

# Optional model override. Groq default: llama-3.3-70b-versatile.
SOTEACH_AI_MODEL=

# Optional: PostgreSQL DSN. When set, the server stores sessions in Postgres
# instead of the file store (otherwise pass -data).
# SOTEACH_POSTGRES_DSN=
